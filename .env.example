# 本地复制为 .env。通知地址和密钥仅保存在服务端，不提交 Git。
PORT=8787
HOST=127.0.0.1
PORTFOLIO_ID=5075281354358777856
TRADER_NAME=熬鹰资本
POLL_INTERVAL_MS=15000
BACKFILL_DAYS=7
DATA_DIR=./data/live
SOURCE_MODE=binance
# 本地可留空；监听非回环地址 / 云端部署必须设置至少 12 位密码。
APP_PASSWORD=
# HTTPS 反向代理部署设置 true；本地 HTTP 保持 false。
COOKIE_SECURE=false
# 留空使用本地嵌入式 PostgreSQL (PGlite)；部署可填写 PostgreSQL 连接串。
DATABASE_URL=
# none | dingtalk | feishu，配置后重启服务。demo 模式始终禁用外部通知。
NOTIFY_PROVIDER=none
NOTIFY_WEBHOOK=
NOTIFY_SECRET=
